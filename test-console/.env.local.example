# KODMOD AI Test Console - local overrides.
# Everything here is optional; the defaults in src/lib/profiles.ts already match
# docker/docker-compose.test.yml, docker/docker-compose.yml and scripts/_testenv.py.

# Absolute or relative path to the Python project root (the nested kodmod-ai/ dir).
# Used to read .env for the "dev" profile, to tail reports/api.log, and to run scripts.
KODMOD_PROJECT_DIR=../kodmod-ai

# Which profile to start on: test | dev
KODMOD_DEFAULT_PROFILE=test

# ---- test profile (scripts/serve_test_api) ----
TEST_API_URL=http://localhost:8000
TEST_PG_URL=postgresql://kodmod:kodmod@localhost:5433/kodmod_test
TEST_REDIS_URL=redis://localhost:6380/0
TEST_QDRANT_URL=http://localhost:6335
TEST_JWT_SECRET=test-secret-not-for-prod-0123456789abcdef
TEST_PG_CONTAINER=kodmod-postgres-test

# ---- dev profile (make dev) ----
# Left blank -> read from KODMOD_PROJECT_DIR/.env at request time.
DEV_API_URL=http://localhost:8000
DEV_PG_URL=
DEV_REDIS_URL=
DEV_QDRANT_URL=
DEV_JWT_SECRET=
DEV_PG_CONTAINER=kodmod-postgres

# Python interpreter used by the /admin script runner.
KODMOD_PYTHON=python
