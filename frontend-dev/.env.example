# KODMOD AI frontend. Copy to `.env.local` and fill in.

# Where the FastAPI backend lives. Sent to the browser, so it must be reachable
# from the browser, not just from the Next.js server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only. Never prefixed with NEXT_PUBLIC: these keys stay on the
# Next.js server, and the browser reaches OpenAI only through /api/transcribe
# and /api/speak.
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=alloy
